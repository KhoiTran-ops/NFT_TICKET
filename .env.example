# Sao file này thành `.env` (không commit) và điền giá trị local.
# KHÔNG đặt secret thật ở đây. Ví deployer/relayer chỉ dùng testnet, mỗi người một ví riêng.
# Danh sách lấy từ PIPELINE_AND_STRUCTURE.md mục 7.

# ---------- Chain (Avalanche Fuji, chainId 43113) ----------
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113
# Khóa ví testnet — để trống, tự tạo ví riêng
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
# Deploy (contracts/script/Deploy.s.sol). Để trống ADMIN_ADDRESS = dùng ví deployer làm admin.
ADMIN_ADDRESS=
# Địa chỉ ví relayer (nhận SCANNER_ROLE khi deploy)
RELAYER_ADDRESS=

# ---------- Backend ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nft_ticket
# Sinh ngẫu nhiên local, ví dụ: openssl rand -hex 32
JWT_SECRET=
GATE_HMAC_SECRET=
FIELD_ENCRYPTION_KEY=
# eKYC (D-006): pepper cho HMAC số CCCD, secret xác thực webhook
KYC_ID_PEPPER=
KYC_WEBHOOK_SECRET=
# MVP dùng MockKycProvider (D-006)
KYC_PROVIDER=mock
# Thanh toán giả lập ở MVP
PAYMENT_PROVIDER=mock

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CHAIN_ID=43113
