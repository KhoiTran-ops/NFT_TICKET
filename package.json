{
  "name": "nft-ticket",
  "private": true,
  "description": "NFT Ticket MVP monorepo (contracts, backend, frontend, packages/shared)",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter '!contracts' run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "openapi:lint": "pnpm --filter @nft-ticket/shared run openapi:lint",
    "contracts:build": "pnpm --filter contracts run forge:build",
    "contracts:test": "pnpm --filter contracts run forge:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
