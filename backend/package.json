{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "description": "API Fastify/TypeScript cho NFT Ticket",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "db:generate": "node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=../.env ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=../.env prisma/seed.mjs",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.mjs'",
    "test:db": "vitest run integration.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "@nft-ticket/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "nodemailer": "10.5.0",
    "otpauth": "9.6.0"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "prisma": "6.19.3"
  }
}
