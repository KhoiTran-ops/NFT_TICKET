generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  org_owner
  org_manager
  gate_staff
  platform_operator
  kyc_reviewer
  platform_admin
}

enum OtpChannel {
  email
  sms
}

enum VerificationLevel {
  L1
  L2
  L3
}

enum KycStatus {
  not_started
  pending
  verified
  rejected
  revoked
}

enum KycReasonCode {
  DOC_UNREADABLE
  DOC_EXPIRED
  DOC_NOT_SUPPORTED
  FACE_MISMATCH
  LIVENESS_FAILED
  DUPLICATE_IDENTITY
  UNDERAGE
  PROVIDER_ERROR
}

enum KybStatus {
  pending
  verified
  rejected
}

enum EventStatus {
  draft
  published
  cancel_requested
  cancelled
  completed
}

enum OrderStatus {
  reserved
  paid
  issued
  expired
  payment_failed
  exception
}

enum TicketStatus {
  active
  listed
  settling
  used
  void_pending_refund
  void
}

enum Currency {
  VND
}

enum ScopeType {
  platform
  organization
  event
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique @db.VarChar(254)
  emailVerifiedAt      DateTime? @db.Timestamptz(3)
  phone                String?   @unique @db.VarChar(16)
  phoneVerifiedAt      DateTime? @db.Timestamptz(3)
  displayName          String
  lockedUntil          DateTime? @db.Timestamptz(3)
  sessionVersion       Int       @default(0)
  totpSecretCiphertext Bytes?
  totpEnabledAt        DateTime? @db.Timestamptz(3)
  totpLastCounter      BigInt?
  totpFailedAttempts   Int       @default(0)
  totpLockedUntil      DateTime? @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @db.Timestamptz(3)

  sessions     Session[]
  auditEntries AuditLog[]
  kyc          KycVerification?
  roles        RoleAssignment[] @relation("Assignee")
  grantedRoles RoleAssignment[] @relation("Grantor")
  orders       Order[]
  tickets      Ticket[]
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  sessionVersion   Int       @default(0)
  familyId         String    @db.Uuid
  refreshTokenHash Bytes     @unique
  expiresAt        DateTime  @db.Timestamptz(3)
  rotatedAt        DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  mfaVerifiedAt    DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model OtpChallenge {
  id         String     @id @default(uuid()) @db.Uuid
  channel    OtpChannel
  targetHash Bytes
  codeHash   Bytes
  attempts   Int        @default(0)
  expiresAt  DateTime   @db.Timestamptz(3)
  consumedAt DateTime?  @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)

  @@index([channel, targetHash, createdAt])
  @@index([expiresAt])
}

enum AuditActorType {
  user
  system
}

model AuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  actorType     AuditActorType @default(user)
  actorId       String?        @db.Uuid
  role          Role?
  systemActor   String?        @db.VarChar(64)
  action        String
  targetType    String
  targetId      String
  before        Json?
  after         Json?
  reason        String
  ip            String?        @db.Inet
  correlationId String
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  actor         User?          @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([targetType, targetId])
}

model KycVerification {
  userId                   String            @id @db.Uuid
  status                   KycStatus         @default(not_started)
  level                    VerificationLevel @default(L1)
  providerRef              String?           @unique
  idNumberHash             Bytes?            @unique
  legalNameCiphertext      Bytes?
  birthDateCiphertext      Bytes?
  idLastFourCiphertext     Bytes?
  documentExpiryCiphertext Bytes?
  verifiedAt               DateTime?         @db.Timestamptz(3)
  reasonCode               KycReasonCode?
  user                     User              @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model RoleAssignment {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  role           Role
  scopeType      ScopeType
  organizationId String?       @db.Uuid
  eventId        String?       @db.Uuid
  grantedById    String?       @db.Uuid
  expiresAt      DateTime?     @db.Timestamptz(3)
  user           User          @relation("Assignee", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy      User?         @relation("Grantor", fields: [grantedById], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id                      String           @id @default(uuid()) @db.Uuid
  legalName               String
  taxId                   String           @unique
  kybStatus               KybStatus        @default(pending)
  issuerAddress           String?          @unique @db.VarChar(42)
  payoutAccountCiphertext Bytes?
  events                  Event[]
  roles                   RoleAssignment[]
}

model Event {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  name            String
  description     String?
  venue           String?
  timezone        String
  policyVersion   String
  status          EventStatus      @default(draft)
  kycRequired     Boolean          @default(false)
  startsAt        DateTime         @db.Timestamptz(3)
  endsAt          DateTime         @db.Timestamptz(3)
  perAccountLimit Int?
  chainId         Int?
  registryAddress String?          @db.VarChar(42)
  onChainEventId  Decimal?         @db.Decimal(78, 0)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tiers           TicketTier[]
  roles           RoleAssignment[]

  @@unique([chainId, registryAddress, onChainEventId])
  @@index([organizationId])
  @@index([status, startsAt, id])
}

model TicketTier {
  id              String   @id @default(uuid()) @db.Uuid
  eventId         String   @db.Uuid
  name            String
  faceValue       BigInt
  currency        Currency @default(VND)
  quantity        Int
  reserved        Int      @default(0)
  sold            Int      @default(0)
  saleStartsAt    DateTime @db.Timestamptz(3)
  saleEndsAt      DateTime @db.Timestamptz(3)
  perAccountLimit Int
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orders          Order[]

  @@index([eventId])
}

// A reserved order is the inventory hold. Its price and policy are snapshots.
model Order {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  tierId           String      @db.Uuid
  status           OrderStatus @default(reserved)
  quantity         Int
  unitPrice        BigInt
  fee              BigInt      @default(0)
  total            BigInt
  currency         Currency    @default(VND)
  policyVersion    String
  policyAcceptedAt DateTime    @db.Timestamptz(3)
  idempotencyKey   String      @db.Uuid
  requestHash      Bytes
  expiresAt        DateTime    @db.Timestamptz(3)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  user             User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  tier             TicketTier  @relation(fields: [tierId], references: [id], onDelete: Restrict)
  tickets          Ticket[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([tierId, userId, status])
  @@index([status, expiresAt])
}

// Confirmed on-chain identity is scoped by chain and contract.
model Ticket {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @db.Uuid
  ownerId         String       @db.Uuid
  faceValue       BigInt
  status          TicketStatus @default(active)
  chainId         Int
  registryAddress String       @db.VarChar(42)
  tokenId         Decimal      @db.Decimal(78, 0)
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@unique([chainId, registryAddress, tokenId])
  @@index([ownerId, status])
  @@index([orderId])
}
